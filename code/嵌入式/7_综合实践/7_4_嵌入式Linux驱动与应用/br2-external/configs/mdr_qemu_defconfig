# MDR 的 IMU 产品，QEMU vexpress-a9（无硬件时的路线）
#
# 这台机器上没有 MPU6050 的 I2C 总线，驱动用 i2c-stub 做冒烟测试；
# 中断路径不可用，驱动退化为"按需读取"。
#
#   make BR2_EXTERNAL=/path/to/7_4_.../br2-external mdr_qemu_defconfig
#   make
#   ./output/images/start-qemu.sh

# 架构：Cortex-A9，32 位 armhf（与 5.4 的 QEMU 平台一致）
BR2_arm=y
BR2_cortex_a9=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# 系统
BR2_TARGET_GENERIC_HOSTNAME="mdr-qemu"
BR2_TARGET_GENERIC_ISSUE="MDR IMU on QEMU"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_DHCP=""

# 内核
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="vexpress_defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="arm/vexpress-v2p-ca9"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# i2c-stub 与 i2c-dev 是冒烟测试的前提，编进内核
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MDR_PATH)/board/mdr/qemu-stub.fragment"

# 根文件系统
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_TAR=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MDR_PATH)/board/mdr/rootfs-overlay-qemu"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MDR_PATH)/board/mdr/post-build.sh"

# 系统工具
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_I2C_TOOLS=y

# MDR 自己的包
BR2_PACKAGE_COREMQTT=y
BR2_PACKAGE_MDR_IMU=y
BR2_PACKAGE_IMUD=y
