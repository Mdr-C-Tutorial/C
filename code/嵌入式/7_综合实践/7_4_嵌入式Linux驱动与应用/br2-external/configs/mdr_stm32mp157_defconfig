# MDR 的 IMU 产品，目标板 STM32MP157 Discovery（DK1/DK2）
#
#   make BR2_EXTERNAL=/path/to/7_4_.../br2-external mdr_stm32mp157_defconfig
#   make
#
# 输出在 output/images/ 下：zImage、stm32mp157a-dk1.dtb、rootfs.ext4、
# sdcard.img。烧到 SD 卡后从板子启动即可。

# 架构：Cortex-A7，32 位 armhf
BR2_arm=y
BR2_cortex_a7=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# 系统
BR2_TARGET_GENERIC_HOSTNAME="mdr-imu"
BR2_TARGET_GENERIC_ISSUE="MDR IMU gateway"
BR2_TARGET_GENERIC_ROOT_PASSWD="mdr"
BR2_SYSTEM_DHCP="eth0"

# 内核：ST 的 DK 板设备树，6.18 LTS
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="st/stm32mp157a-dk1 st/stm32mp157c-dk2"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# 根文件系统
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_ROOTFS_TAR=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MDR_PATH)/board/mdr/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MDR_PATH)/board/mdr/post-build.sh"

# 系统工具
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_I2C_TOOLS=y

# 网络
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IFUPDOWN_SCRIPTS=y
BR2_PACKAGE_DHCPCD=y

# MDR 自己的包
BR2_PACKAGE_COREMQTT=y
BR2_PACKAGE_MDR_IMU=y
BR2_PACKAGE_IMUD=y
