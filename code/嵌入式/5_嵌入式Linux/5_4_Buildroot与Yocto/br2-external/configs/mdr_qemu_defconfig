# MDR 的 QEMU 板级配置（Buildroot 2026.02 LTS）
#
# 用法：在一个干净的构建目录里
#   make BR2_EXTERNAL=/path/to/br2-external mdr_qemu_defconfig
#   make
#
# 生成的映像在 output/images/ 下，用 start-qemu.sh 启动。

# 架构与工具链
BR2_arm=y
BR2_cortex_a9=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# 系统
BR2_TARGET_GENERIC_HOSTNAME="mdr"
BR2_TARGET_GENERIC_ISSUE="Welcome to MDR"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_DHCP=""

# 内核
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="vexpress_defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="arm/vexpress-v2p-ca9"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# 根文件系统
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_TAR=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MDR_PATH)/board/mdr/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MDR_PATH)/board/mdr/post-build.sh"

# 系统工具
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_KMOD=y

# 网络与设备管理
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IFUPDOWN_SCRIPTS=y

# MDR 自己的软件包
BR2_PACKAGE_SENSORD=y
BR2_PACKAGE_MDR_FIFO=y